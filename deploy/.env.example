# Domain pointing at this VM. No domain? Use sslip.io: for IP 140.238.12.34 use 140-238-12-34.sslip.io
RUNNER_DOMAIN=140-238-12-34.sslip.io
# Long random secret shared with the web app (Vercel env RUNNER_TOKEN). Generate: openssl rand -hex 32
RUNNER_TOKEN=change-me
# How many programs may run at the same time (each Selenium run uses ~500 MB RAM)
RUNNER_CONCURRENCY=2
